<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Physical Parameters — AquaGuard</title>
  <meta name="description" content="Enter physical water quality measurements — pH, Temperature, Turbidity, Conductivity, TDS.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    /* ── FORM PAGE HERO ── */
    .form-hero {
      position: relative;
      padding: calc(var(--nav-h) + 3rem) 2rem 2.5rem;
      background: linear-gradient(160deg, #040f23 0%, #0a2547 60%, #001635 100%);
      overflow: hidden;
    }
    .form-hero .fh-orb { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; animation: float 7s ease-in-out infinite; }
    .form-hero .fh-orb1 { width: 250px; height: 250px; background: rgba(0,180,216,0.1); top: -40px; right: 10%; animation-delay: 0s; }
    .form-hero .fh-orb2 { width: 160px; height: 160px; background: rgba(72,202,228,0.07); bottom: -20px; left: 5%; animation-delay: 2.5s; }
    .form-hero-inner { position: relative; z-index: 2; max-width: 700px; }
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--muted); margin-bottom: 1.25rem; }
    .breadcrumb a { color: var(--muted); transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { color: var(--accent); }
    .form-hero h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 800; margin: 0.5rem 0 0.6rem; }
    .form-hero p { color: var(--muted); font-size: 0.92rem; max-width: 500px; }
    .form-hero-wave { position: absolute; bottom: 0; left: 0; width: 100%; z-index: 1; }
    .form-hero-wave svg { display: block; }

    /* ── FORM LAYOUT ── */
    .form-page { padding: 3rem 1.5rem 5rem; }
    .form-container { max-width: 720px; margin: 0 auto; }

    /* ── FORM CARD ── */
    .form-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow);
      position: relative; overflow: hidden;
    }
    .form-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
    }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
    @media(max-width:540px) { .form-grid { grid-template-columns: 1fr; } }
    .form-grid .full { grid-column: 1/-1; }
    .param-unit {
      position: absolute; right: 1rem; top: 50%; transform: translateY(-50%);
      font-size: 0.75rem; color: var(--muted); font-family: 'Roboto Mono', monospace; pointer-events: none;
    }
    .form-actions { display: flex; gap: 1rem; margin-top: 1.25rem; }
    .form-actions .btn { flex: 1; justify-content: center; }

    /* ── RESULT MSG ── */
    .result-msg { display: none; padding: 1rem 1.2rem; border-radius: 10px; font-size: 0.88rem; margin-bottom: 1.25rem; }
    .result-msg.success { background: rgba(6,214,160,0.1); border: 1px solid rgba(6,214,160,0.3); color: var(--green); }
    .result-msg.error   { background: rgba(239,71,111,0.1); border: 1px solid rgba(239,71,111,0.3); color: var(--danger); }

    /* ── DIVIDERS & LABELS ── */
    .divider { height: 1px; background: var(--border); margin: 1.5rem 0; }
    .section-sub { font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .section-sub::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── TIPS BOX ── */
    .tips-box {
      background: rgba(0,180,216,0.06); border: 1px solid rgba(0,180,216,0.2);
      border-radius: var(--r); padding: 1rem 1.25rem; margin-top: 1.5rem;
    }
    .tips-box h4 { font-size: 0.8rem; font-weight: 700; color: var(--accent); margin-bottom: 0.5rem; }
    .tips-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.3rem; }
    .tips-box ul li { font-size: 0.78rem; color: var(--muted); display: flex; align-items: flex-start; gap: 0.5rem; }
    .tips-box ul li::before { content: '💡'; flex-shrink: 0; font-size: 0.75rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical" style="color:var(--accent)">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a><a href="/w3iwqi">Irrigation-WQI</a><a href="/w2gwqi">Ground-WQI</a><a href="/w7delphiwqi">DELPHI-WQI</a><a href="/w8minewqi">Mine-WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<!-- HERO -->
<div class="form-hero">
  <div class="fh-orb fh-orb1"></div>
  <div class="fh-orb fh-orb2"></div>
  <div class="form-hero-inner fu">
    <div class="breadcrumb">
      <a href="/fwater">Dashboard</a> <span>›</span> <a href="/fwater#enter-data">Data Entry</a> <span>›</span> <span>Physical</span>
    </div>
    <span class="badge badge-cyan">🧪 Physical Parameters</span>
    <h1 style="margin-top:0.75rem">Physical Data <span class="g-text">Entry</span></h1>
    <p>Record physical water quality measurements — pH, temperature, turbidity, conductivity, and total dissolved solids.</p>
  </div>
  <div class="form-hero-wave">
    <svg viewBox="0 0 1440 50" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,25 C240,50 480,0 720,25 C960,50 1200,0 1440,25 L1440,50 L0,50 Z" fill="#0a192f"/>
    </svg>
  </div>
</div>

<div class="form-page">
  <div class="form-container">
    <div class="form-card fu-1">
      <div class="result-msg" id="resultMsg"></div>

      <p class="section-sub">Sample Identification</p>
      <form id="physicalForm" onsubmit="submitForm(event)">
        <div class="form-group">
          <label class="form-label">Sample ID *</label>
          <input type="text" name="sampleID" class="form-control" placeholder="e.g. WS-2024-001" required>
          <span class="form-hint">Unique identifier for this water sample</span>
        </div>
        <div class="divider"></div>
        <p class="section-sub">Physical Measurements</p>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">pH Value *</label>
            <div style="position:relative;">
              <input type="number" step="0.01" min="0" max="14" name="phValue" class="form-control" placeholder="7.0" required>
              <span class="param-unit">0–14</span>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Temperature *</label>
            <div style="position:relative;">
              <input type="number" step="0.01" name="temperature" class="form-control" placeholder="25.0" required>
              <span class="param-unit">°C</span>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Turbidity *</label>
            <div style="position:relative;">
              <input type="number" step="0.01" min="0" name="turbidity" class="form-control" placeholder="0.5" required>
              <span class="param-unit">NTU</span>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Conductivity *</label>
            <div style="position:relative;">
              <input type="number" step="0.01" min="0" name="conductivity" class="form-control" placeholder="500" required>
              <span class="param-unit">µS/cm</span>
            </div>
          </div>
          <div class="form-group full">
            <label class="form-label">Total Dissolved Solids (TDS) *</label>
            <div style="position:relative;">
              <input type="number" step="0.01" min="0" name="tds" class="form-control" placeholder="250" required>
              <span class="param-unit">mg/L</span>
            </div>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="submitBtn">
            <span>💾 Save Data</span>
            <span class="spinner" style="display:none;width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.7s linear infinite;"></span>
          </button>
          <button type="reset" class="btn btn-ghost">↺ Reset</button>
          <a href="/fwater" class="btn btn-ghost">← Dashboard</a>
        </div>
      </form>

      <div class="tips-box">
        <h4>📌 Measurement Notes</h4>
        <ul>
          <li>pH should be measured within 15 minutes of sample collection.</li>
          <li>Turbidity values above 4 NTU indicate poor water quality for drinking.</li>
          <li>Acceptable TDS for drinking water: &lt; 500 mg/L (WHO standard).</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Water Pollution Analysis System</p></footer>

<script>
  window.addEventListener('scroll',()=>document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>10));
  async function submitForm(e) {
    e.preventDefault();
    const form = e.target, btn = document.getElementById('submitBtn'), msg = document.getElementById('resultMsg');
    btn.disabled = true; btn.querySelector('span').style.display='none'; btn.querySelector('.spinner').style.display='block';
    msg.style.display='none';
    try {
      const res = await fetch('/physical', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      if(res.ok || res.redirected) {
        msg.className='result-msg success'; msg.innerHTML='✅ Physical data saved successfully!'; msg.style.display='block';
        form.reset(); setTimeout(()=>{ msg.style.display='none'; }, 3500);
      } else {
        const r = await res.json();
        msg.className='result-msg error'; msg.innerHTML='⚠️ '+(r.message||'Error saving data.'); msg.style.display='block';
      }
    } catch(err){ msg.className='result-msg error'; msg.innerHTML='⚠️ Network error. Please try again.'; msg.style.display='block'; }
    finally { btn.disabled=false; btn.querySelector('span').style.display=''; btn.querySelector('.spinner').style.display='none'; }
  }
</script>
</body>
</html>
