<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chemical Data Records — AquaGuard</title>
  <meta name="description" content="View chemical water quality data records — DO, BOD, COD, Ammonia, Nitrate, Nitrite, Phosphate, Chlorite.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .data-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 4rem; min-height: 100vh; }
    .data-container { max-width: 1200px; margin: 0 auto; }
    .data-header { margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .table-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 1.5rem; overflow-x: auto; box-shadow: var(--shadow);
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th, td { padding: 0.85rem 0.8rem; text-align: left; border-bottom: 1px solid var(--border); white-space: nowrap; }
    th {
      background: rgba(130,90,230,0.1); color: #9b72ff; font-weight: 700;
      text-transform: uppercase; font-size: 0.73rem; letter-spacing: 0.08em;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.03); }
    .val-critical { color: var(--danger); font-weight: 700; }
    .val-warning  { color: var(--warn); font-weight: 600; }
    .val-safe     { color: var(--green); font-weight: 600; }
    .no-data { text-align: center; padding: 2.5rem; color: var(--muted); font-style: italic; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="data-page">
  <div class="data-container">
    <div class="data-header fu">
      <div>
        <span class="badge badge-cyan" style="background:rgba(130,90,230,0.12);color:#9b72ff;border-color:rgba(130,90,230,0.3)">⚗️ Chemical Data</span>
        <h1 style="font-size:1.9rem;margin-top:0.5rem">Chemical Data <span class="g-text">Records</span></h1>
      </div>
      <a href="/information" class="btn btn-ghost">← Back to Data Info</a>
    </div>

    <div class="table-card fu-1">
      <table>
        <thead>
          <tr>
            <th>No.</th><th>Sample ID</th><th>DO (mg/L)</th><th>BOD (mg/L)</th><th>COD (mg/L)</th><th>NH₃ (mg/L)</th><th>NO₃ (mg/L)</th><th>NO₂ (mg/L)</th><th>Phosphate</th><th>Chlorite</th><th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof chemicalData !== 'undefined' && chemicalData.length > 0) { %>
            <% chemicalData.forEach((data, index) => { %>
              <tr>
                <td style="color:var(--muted)"><%= index + 1 %></td>
                <td><strong style="color:var(--white)"><%= data.sampleID %></strong></td>
                <td><%= data.do %></td>
                <td><%= data.bod %></td>
                <td><%= data.cod %></td>
                <td><%= data.nh3 %></td>
                <td><%= data.no3 %></td>
                <td><%= data.no2 %></td>
                <td><%= data.phosphate %></td>
                <td><%= data.chlorite %></td>
                <td style="color:var(--muted)"><%= new Date(data.date).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="11" class="no-data">No chemical data records found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Water Pollution Analysis System</p></footer>
<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));
</script>
</body>
</html>