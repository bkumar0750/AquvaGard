<script>
  // Navbar scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => { navbar.classList.toggle('scrolled', window.scrollY > 40); });

  // Particles
  (() => {
    const c = document.getElementById('particles');
    for (let i = 0; i < 40; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      const s = Math.random() * 12 + 4;
      p.style.cssText = `width:${s}px;height:${s}px;left:${Math.random()*100}vw;top:${Math.random()*100}%;opacity:${Math.random()*0.5+0.1};animation-duration:${Math.random()*20+10}s;animation-delay:${Math.random()*10}s;`;
      c.appendChild(p);
    }
  })();

  // Gallery
  (() => {
    const slides = [
      { image:'/images/pollu1.jpg', caption:'Drain water — Gate 2 IIT KGP', loc:'IIT Kharagpur' },
      { image:'/images/pollu2.jpg', caption:'Polluted drain near Gate 2',    loc:'IIT Kharagpur' },
      { image:'/images/pollu3.jpg', caption:'Chemical Reagent Lab',           loc:'Research Lab' },
      { image:'/images/pollu4.jpg', caption:'Near Food Studio',               loc:'IIT Campus' },
      { image:'/images/pollu5.jpg', caption:'Urban sewage polluting drain',   loc:'Field Study' },
    ];
    const track = document.getElementById('galleryTrack');
    slides.forEach(s => {
      const el = document.createElement('div');
      el.className = 'gallery-slide';
      el.innerHTML = `<img src="${s.image}" alt="${s.caption}"><div class="slide-caption"><h4>${s.caption}</h4><p>📍 ${s.loc}</p></div>`;
      track.appendChild(el);
    });
    // clone for infinite loop
    track.appendChild(track.firstElementChild.cloneNode(true));
    track.insertBefore(track.lastElementChild.cloneNode(true), track.firstElementChild);
    let idx = 1;
    const go = (n) => { idx += n; track.style.transition='transform 0.5s ease'; track.style.transform=`translateX(-${idx*100}%)`; };
    track.addEventListener('transitionend', () => {
      if (idx >= slides.length+1){ idx=1; track.style.transition='none'; track.style.transform=`translateX(-100%)`; }
      if (idx <= 0){ idx=slides.length; track.style.transition='none'; track.style.transform=`translateX(-${slides.length*100}%)`; }
    });
    document.getElementById('nextBtn').onclick = () => go(1);
    document.getElementById('prevBtn').onclick = () => go(-1);
    track.style.transform = `translateX(-100%)`;
    setInterval(() => go(1), 5000);
  })();
</script>
