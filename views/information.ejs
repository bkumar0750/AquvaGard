<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Information — AquaGuard</title>
  <meta name="description" content="View all stored water quality sample records — physical, chemical, biological, air, and environmental data from AquaGuard.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    /* ── PAGE HERO ── */
    .info-hero {
      position: relative;
      padding: calc(var(--nav-h) + 4rem) 2rem 3.5rem;
      text-align: center;
      background: linear-gradient(160deg, #040f23 0%, #0a2547 55%, #001635 100%);
      overflow: hidden;
    }
    .info-hero .orb { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; animation: float 7s ease-in-out infinite; }
    .info-hero .orb1 { width: 300px; height: 300px; background: rgba(0,180,216,0.1); top: -50px; left: -70px; animation-delay: 0s; }
    .info-hero .orb2 { width: 220px; height: 220px; background: rgba(72,202,228,0.07); bottom: -40px; right: -60px; animation-delay: 3s; }
    .info-hero-inner { position: relative; z-index: 2; max-width: 600px; margin: 0 auto; }
    .info-hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; margin: 1rem 0 0.75rem; }
    .info-hero p { color: var(--muted); font-size: 1rem; line-height: 1.7; }
    .info-hero-wave { position: absolute; bottom: 0; left: 0; width: 100%; z-index: 1; }
    .info-hero-wave svg { display: block; }

    /* ── SECTION ── */
    .info-section { padding: 4rem 2rem 5rem; }
    .info-container { max-width: 1100px; margin: 0 auto; }

    /* ── STAT ROW ── */
    .stat-row {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 3rem;
    }
    @media(max-width:900px){ .stat-row{ grid-template-columns:repeat(3,1fr); } }
    @media(max-width:500px){ .stat-row{ grid-template-columns:repeat(2,1fr); } }
    .stat-mini {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r);
      padding: 1.1rem; text-align: center; transition: all 0.3s;
    }
    .stat-mini:hover { border-color: var(--border-h); box-shadow: var(--glow); transform: translateY(-3px); }
    .stat-mini-val { font-size: 1.75rem; font-weight: 800; color: var(--accent); font-family: 'Roboto Mono', monospace; display: block; }
    .stat-mini-label { font-size: 0.73rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em; }

    /* ── DATA BOXES ── */
    .data-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;
    }
    .data-box {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      overflow: hidden; cursor: pointer; transition: all 0.35s; text-decoration: none; display: block;
      position: relative;
    }
    .data-box::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(0,180,216,0.06), transparent);
      opacity: 0; transition: opacity 0.3s;
    }
    .data-box:hover { border-color: var(--border-h); box-shadow: var(--glow); transform: translateY(-5px); }
    .data-box:hover::after { opacity: 1; }

    .data-box-header {
      padding: 1.5rem 1.5rem 1rem;
      display: flex; align-items: center; gap: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .data-box-icon {
      width: 50px; height: 50px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; flex-shrink: 0;
    }
    .icon-blue   { background: rgba(0,180,216,0.14); }
    .icon-purple { background: rgba(130,90,230,0.14); }
    .icon-green  { background: rgba(6,214,160,0.14); }
    .icon-orange { background: rgba(255,140,60,0.14); }
    .icon-teal   { background: rgba(0,200,180,0.14); }

    .data-box-header h3 { font-size: 1.05rem; font-weight: 700; color: var(--white); margin: 0 0 0.2rem; }
    .data-box-header .data-count {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.2rem 0.7rem; border-radius: 50px;
      font-size: 0.72rem; font-weight: 700;
      background: rgba(0,180,216,0.1); color: var(--accent); border: 1px solid rgba(0,180,216,0.25);
      transition: all 0.3s;
    }

    .data-box-body { padding: 1rem 1.5rem 1.5rem; min-height: 130px; }
    .data-item {
      padding: 0.45rem 0; border-bottom: 1px dashed rgba(255,255,255,0.07);
      font-size: 0.83rem; color: var(--muted); transition: all 0.2s;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .data-item:last-child { border-bottom: none; }
    .data-item:hover { color: var(--text); transform: translateX(4px); }
    .data-item::before { content: '·'; color: var(--accent); font-size: 1.2rem; flex-shrink: 0; }

    .data-box-footer {
      padding: 0.85rem 1.5rem; border-top: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 0.82rem; color: var(--muted);
    }
    .data-box-footer .link-arrow { color: var(--accent); font-weight: 700; font-size: 0.8rem; transition: transform 0.2s; display: inline-flex; align-items: center; gap: 0.3rem; }
    .data-box:hover .link-arrow { transform: translateX(4px); }

    /* loading pulse */
    .loading-pulse { animation: loadPulse 1.4s ease-in-out infinite; }
    @keyframes loadPulse { 0%,100%{opacity:0.4} 50%{opacity:1} }
    .skeleton { height: 0.7rem; background: var(--surface2); border-radius: 4px; margin: 0.4rem 0; }
    .skeleton.sm { width: 60%; }
    .skeleton.md { width: 80%; }
    .skeleton.lg { width: 95%; }

    /* error state */
    .data-error { text-align: center; padding: 1.5rem; color: var(--danger); font-size: 0.85rem; }
    .empty-state { text-align: center; padding: 1.5rem; color: var(--muted); font-size: 0.85rem; }
  </style>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand">
    <div class="nav-logo">💧</div>
    <span class="nav-name">Aqua<span>Guard</span></span>
  </a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd">
      <button>Data Entry</button>
      <div class="dd-menu">
        <a href="/physical">🧪 Physical</a>
        <a href="/chemical">⚗️ Chemical</a>
        <a href="/biological">🦠 Biological</a>
        <a href="/environmental">🌿 Environmental</a>
        <a href="/air">💨 Air Quality</a>
      </div>
    </li>
    <li class="nav-dd">
      <a href="#">WQI Calculators</a>
      <div class="dd-menu">
        <a href="/w6swqi">Simple WQI</a>
        <a href="/w4nsfwqi">NSF-WQI</a>
        <a href="/w5wawqi">WA-WQI</a>
        <a href="/w1ccmewqi">CCME-WQI</a>
        <a href="/w3iwqi">Irrigation-WQI</a>
        <a href="/w2gwqi">Ground-WQI</a>
        <a href="/w7delphiwqi">DELPHI-WQI</a>
        <a href="/w8minewqi">Mine-WQI</a>
      </div>
    </li>
    <li><a href="/treatment">Treatment</a></li>
    <li><a href="/AQI">AQI</a></li>
    <li><a href="/parameters">Parameters</a></li>
    <li><a href="/information" style="color:var(--accent)">Data Info</a></li>
  </ul>
  <button class="nav-toggle" id="navToggle" onclick="document.getElementById('navLinks').classList.toggle('open')">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- ── HERO ── -->
<div class="info-hero">
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <div class="info-hero-inner fu">
    <span class="badge badge-cyan" style="margin-bottom:1rem">📂 Data Repository</span>
    <h1>Sample <span class="g-text">Data Records</span></h1>
    <p>Browse all stored water quality measurements across physical, chemical, biological, environmental, and air quality categories.</p>
  </div>
  <div class="info-hero-wave">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z" fill="#0a192f"/>
    </svg>
  </div>
</div>

<!-- ── CONTENT ── -->
<section class="info-section">
  <div class="info-container">

    <!-- Stat Row -->
    <div class="stat-row" id="statRow">
      <div class="stat-mini"><span class="stat-mini-val" id="tot-physical">—</span><span class="stat-mini-label">Physical</span></div>
      <div class="stat-mini"><span class="stat-mini-val" id="tot-chemical">—</span><span class="stat-mini-label">Chemical</span></div>
      <div class="stat-mini"><span class="stat-mini-val" id="tot-biological">—</span><span class="stat-mini-label">Biological</span></div>
      <div class="stat-mini"><span class="stat-mini-val" id="tot-air">—</span><span class="stat-mini-label">Air Quality</span></div>
      <div class="stat-mini"><span class="stat-mini-val" id="tot-other">—</span><span class="stat-mini-label">Environmental</span></div>
    </div>

    <!-- Data Grid -->
    <div class="data-grid">

      <!-- Physical -->
      <a class="data-box fu" href="/pdi">
        <div class="data-box-header">
          <div class="data-box-icon icon-blue">🧪</div>
          <div>
            <h3>Physical Parameters</h3>
            <span class="data-count" id="count-physical">Loading…</span>
          </div>
        </div>
        <div class="data-box-body" id="body-physical">
          <div class="loading-pulse">
            <div class="skeleton lg"></div>
            <div class="skeleton md"></div>
            <div class="skeleton sm"></div>
          </div>
        </div>
        <div class="data-box-footer">
          <span style="font-size:0.75rem">pH, Temp, Turbidity, TDS…</span>
          <span class="link-arrow">View all →</span>
        </div>
      </a>

      <!-- Chemical -->
      <a class="data-box fu-1" href="/cdi">
        <div class="data-box-header">
          <div class="data-box-icon icon-purple">⚗️</div>
          <div>
            <h3>Chemical Parameters</h3>
            <span class="data-count" id="count-chemical">Loading…</span>
          </div>
        </div>
        <div class="data-box-body" id="body-chemical">
          <div class="loading-pulse">
            <div class="skeleton lg"></div>
            <div class="skeleton md"></div>
            <div class="skeleton sm"></div>
          </div>
        </div>
        <div class="data-box-footer">
          <span style="font-size:0.75rem">DO, BOD, COD, Nitrate…</span>
          <span class="link-arrow">View all →</span>
        </div>
      </a>

      <!-- Biological -->
      <a class="data-box fu-2" href="/bdi">
        <div class="data-box-icon icon-green" style="margin:1.5rem 1.5rem 0">🦠</div>
        <div class="data-box-header" style="padding-top:0.75rem">
          <div>
            <h3>Biological Parameters</h3>
            <span class="data-count" id="count-biological">Loading…</span>
          </div>
        </div>
        <div class="data-box-body" id="body-biological">
          <div class="loading-pulse">
            <div class="skeleton lg"></div>
            <div class="skeleton md"></div>
            <div class="skeleton sm"></div>
          </div>
        </div>
        <div class="data-box-footer">
          <span style="font-size:0.75rem">Coliform, Algae, Pathogens…</span>
          <span class="link-arrow">View all →</span>
        </div>
      </a>

      <!-- Air -->
      <a class="data-box fu-3" href="/adi">
        <div class="data-box-header">
          <div class="data-box-icon icon-orange">💨</div>
          <div>
            <h3>Air Quality Parameters</h3>
            <span class="data-count" id="count-air">Loading…</span>
          </div>
        </div>
        <div class="data-box-body" id="body-air">
          <div class="loading-pulse">
            <div class="skeleton lg"></div>
            <div class="skeleton md"></div>
            <div class="skeleton sm"></div>
          </div>
        </div>
        <div class="data-box-footer">
          <span style="font-size:0.75rem">PM, SO₂, NO₂, CO, VOCs…</span>
          <span class="link-arrow">View all →</span>
        </div>
      </a>

      <!-- Environmental / Other -->
      <a class="data-box fu-4" href="/odi">
        <div class="data-box-header">
          <div class="data-box-icon icon-teal">🌿</div>
          <div>
            <h3>Environmental Parameters</h3>
            <span class="data-count" id="count-other">Loading…</span>
          </div>
        </div>
        <div class="data-box-body" id="body-other">
          <div class="loading-pulse">
            <div class="skeleton lg"></div>
            <div class="skeleton md"></div>
            <div class="skeleton sm"></div>
          </div>
        </div>
        <div class="data-box-footer">
          <span style="font-size:0.75rem">Radiological, Noise, Soil, Waste…</span>
          <span class="link-arrow">View all →</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer class="footer">
  <p>© 2025 <strong>AquaGuard</strong> — Water Pollution Analysis System &nbsp;·&nbsp; Made with ♥ for a cleaner planet &nbsp;·&nbsp; <a href="/fwater">← Dashboard</a></p>
</footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  const categories = ['physical','chemical','biological','air','other'];

  async function fetchData() {
    try {
      const res = await fetch('/information/data');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      categories.forEach(cat => renderBox(cat, data[cat]));
    } catch(err) {
      console.error('Fetch error:', err);
      categories.forEach(cat => {
        document.getElementById('body-' + cat).innerHTML = '<div class="data-error">⚠️ Could not load data.</div>';
        document.getElementById('count-' + cat).textContent = 'Error';
        document.getElementById('tot-' + cat).textContent = '!';
      });
    }
  }

  function renderBox(cat, dataset) {
    const body = document.getElementById('body-' + cat);
    const count = document.getElementById('count-' + cat);
    const tot = document.getElementById('tot-' + cat);

    if (!Array.isArray(dataset) || dataset.length === 0) {
      body.innerHTML = '<div class="empty-state">No records yet.</div>';
      count.textContent = '0 records';
      tot.textContent = '0';
      return;
    }

    const max = Math.min(dataset.length, 4);
    body.innerHTML = dataset.slice(0, max).map(item =>
      `<div class="data-item">${item}</div>`
    ).join('') + (dataset.length > max ? `<div style="font-size:0.75rem;color:var(--muted);padding:0.4rem 0">+${dataset.length - max} more</div>` : '');

    count.textContent = dataset.length + ' record' + (dataset.length !== 1 ? 's' : '');
    // animate count
    tot.textContent = '0';
    animateCount(tot, dataset.length);
  }

  function animateCount(el, target) {
    let current = 0;
    const step = Math.ceil(target / 20);
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = current;
      if (current >= target) clearInterval(timer);
    }, 40);
  }

  document.addEventListener('DOMContentLoaded', fetchData);

  // Fix biological box header issue (it was laid out manually)
  const bioBox = document.querySelector('#body-biological').closest('.data-box');
  if (bioBox) {
    const header = bioBox.querySelector('.data-box-header');
    const icon = bioBox.querySelector('.data-box-icon.icon-green');
    if (icon && header && !header.contains(icon)) {
      header.prepend(icon);
    }
  }
</script>
</body>
</html>
