  <meta name="description" content="Comprehensive analysis of Biochemical Oxygen Demand (BOD5), organic water pollution, aquatic impact, and testing procedures.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .param-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .param-container { max-width: 900px; margin: 0 auto; }
    .param-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.5rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .param-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--purple)); }
    
    .param-meta { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0 2rem; }
    .meta-box { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--r); padding: 0.85rem 1.25rem; flex: 1; min-width: 180px; }
    .meta-lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .meta-val { font-size: 1.2rem; font-weight: 700; color: var(--accent); font-family: 'Roboto Mono', monospace; }

    .content-sec { line-height: 1.8; color: var(--light); margin-bottom: 1.5rem; }
    .content-sec h2 { font-size: 1.25rem; color: var(--white); margin: 1.5rem 0 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
  </style>
</head>
<body>
