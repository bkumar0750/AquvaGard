<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Water Treatment Cost Calculator — AquaGuard</title>
  <meta name="description" content="Comprehensive cost analysis and financial modeling for wastewater and water treatment plants.">
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    /* ── PAGE HERO ── */
    .t-hero {
      position: relative;
      padding: calc(var(--nav-h) + 3rem) 2rem 2.5rem;
      background: linear-gradient(160deg, #040f23 0%, #0a2547 60%, #001635 100%);
      overflow: hidden; text-align: center;
    }
    .t-hero .orb { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; animation: float 7s ease-in-out infinite; }
    .t-hero .orb1 { width: 250px; height: 250px; background: rgba(0,180,216,0.1); top: -40px; right: 10%; animation-delay: 0s; }
    .t-hero .orb2 { width: 160px; height: 160px; background: rgba(6,214,160,0.06); bottom: -20px; left: 5%; animation-delay: 2.5s; }
    .t-hero-inner { position: relative; z-index: 2; max-width: 700px; margin: 0 auto; }
    .t-hero h1 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); font-weight: 800; margin: 0.5rem 0 0.6rem; }
    .t-hero p { color: var(--muted); font-size: 0.95rem; }
    .t-hero-wave { position: absolute; bottom: 0; left: 0; width: 100%; z-index: 1; }
    .t-hero-wave svg { display: block; }

    /* ── PAGE CONTENT ── */
    .t-page { padding: 3rem 1.5rem 5rem; }
    .t-container { max-width: 1100px; margin: 0 auto; }

    /* ── TABS ── */
    .tabs-nav {
      display: flex; gap: 0.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem; justify-content: center; flex-wrap: wrap;
    }
    .tab-btn {
      padding: 0.75rem 1.5rem; border-radius: var(--r); font-weight: 600; font-size: 0.9rem;
      color: var(--muted); background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      cursor: pointer; transition: all 0.3s; display: inline-flex; align-items: center; gap: 0.5rem;
    }
    .tab-btn:hover { color: var(--white); border-color: var(--border-h); background: rgba(255,255,255,0.06); }
    .tab-btn.active { color: var(--accent); border-color: var(--accent); background: rgba(0,180,216,0.12); box-shadow: var(--glow); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* ── CARD & FORM ── */
    .calc-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .calc-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--green));
    }
    .calc-card h2 { font-size: 1.3rem; font-weight: 700; color: var(--white); margin-bottom: 0.3rem; display: flex; align-items: center; gap: 0.6rem; }
    .calc-card .sub { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.75rem; }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.75rem; }

    /* ── RESULTS ── */
    .results-panel {
      margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); display: none;
    }
    .results-panel h3 { font-size: 1.15rem; font-weight: 700; color: var(--white); margin-bottom: 1.25rem; }

    .stat-cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card {
      background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--r);
      padding: 1.1rem; text-align: center;
    }
    .stat-card-label { font-size: 0.73rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.3rem; }
    .stat-card-val { font-size: 1.5rem; font-weight: 800; color: var(--accent); font-family: 'Roboto Mono', monospace; }

    .chart-box {
      background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: var(--r);
      padding: 1.5rem; margin: 1.5rem 0; height: 350px; position: relative;
    }

    table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.88rem; }
    th, td { padding: 0.8rem 1rem; text-align: left; border-bottom: 1px solid var(--border); }
    th { background: rgba(0,180,216,0.1); color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .info-callout {
      background: rgba(0,180,216,0.05); border: 1px solid rgba(0,180,216,0.2);
      border-radius: var(--r); padding: 1.25rem; margin-top: 2rem; font-size: 0.85rem; color: var(--muted);
    }
    .info-callout h4 { font-size: 0.9rem; font-weight: 700; color: var(--accent); margin-bottom: 0.5rem; }
    .info-callout ul { padding-left: 1.2rem; margin-top: 0.4rem; }
    .info-callout li { margin-bottom: 0.25rem; }
  </style>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a></div></li>
    <li><a href="/treatment" style="color:var(--accent)">Treatment</a></li>
    <li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<!-- ── HERO ── -->
<div class="t-hero">
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <div class="t-hero-inner fu">
    <span class="badge badge-cyan" style="margin-bottom:0.75rem">💰 Financial Modeling</span>
    <h1>Treatment Cost <span class="g-text">Calculator</span></h1>
    <p>Comprehensive cost analysis for urban wastewater and raw water treatment plants based on empirical research.</p>
  </div>
  <div class="t-hero-wave">
    <svg viewBox="0 0 1440 50" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,25 C240,50 480,0 720,25 C960,50 1200,0 1440,25 L1440,50 L0,50 Z" fill="#0a192f"/>
    </svg>
  </div>
</div>

<div class="t-page">
  <div class="t-container">

    <!-- Tabs Nav -->
    <div class="tabs-nav fu">
      <button class="tab-btn active" onclick="openTab('wastewater', this)"><i class="fas fa-recycle"></i> Wastewater Treatment</button>
      <button class="tab-btn" onclick="openTab('water', this)"><i class="fas fa-tint"></i> Water Treatment</button>
      <button class="tab-btn" onclick="openTab('compare', this)"><i class="fas fa-balance-scale"></i> Compare Options</button>
    </div>

    <!-- ── TAB 1: WASTEWATER ── -->
    <div id="wastewater" class="tab-content active fu-1">
      <div class="calc-card">
        <h2><i class="fas fa-recycle" style="color:var(--accent)"></i> Wastewater Treatment Plant Operating Costs</h2>
        <p class="sub">Based on research from <em>"Investigation of Operating Costs at an Urban Wastewater Treatment Plant"</em> (Altin et al., 2020)</p>

        <div class="form-grid">
          <div class="form-group"><label class="form-label">Served Population</label><input type="number" id="population" class="form-control" value="108000"></div>
          <div class="form-group"><label class="form-label">Daily Flow Rate (m³/day)</label><input type="number" id="flowRate" class="form-control" value="34128"></div>
          <div class="form-group"><label class="form-label">Average COD (mg/L)</label><input type="number" id="cod" class="form-control" value="400"></div>
          <div class="form-group"><label class="form-label">Average BOD (mg/L)</label><input type="number" id="bod" class="form-control" value="230"></div>
          <div class="form-group"><label class="form-label">Electricity Cost (₹/kWh)</label><input type="number" id="energyCost" step="0.01" class="form-control" value="8.50"></div>
          <div class="form-group"><label class="form-label">Staff Cost per Person (₹/year)</label><input type="number" id="staffCost" step="1000" class="form-control" value="350000"></div>
        </div>

        <button class="btn btn-primary btn-lg" onclick="calculateWastewaterCosts()">⚡ Calculate Operating Costs</button>

        <div id="wastewaterResults" class="results-panel">
          <h3>📊 Operating Cost Results</h3>
          <div class="stat-cards-grid">
            <div class="stat-card"><div class="stat-card-label">Annual Volume</div><div class="stat-card-val" id="annualVolume">—</div></div>
            <div class="stat-card"><div class="stat-card-label">Total Annual Cost</div><div class="stat-card-val" id="totalCost">—</div></div>
            <div class="stat-card"><div class="stat-card-label">Cost per m³</div><div class="stat-card-val" id="costPerCubicMeter">—</div></div>
          </div>

          <div class="chart-box"><canvas id="wastewaterCostChart"></canvas></div>

          <table>
            <thead><tr><th>Component</th><th>Annual Cost</th><th>Percentage</th></tr></thead>
            <tbody>
              <tr><td>Electricity</td><td id="electricityCost"></td><td id="electricityPercent"></td></tr>
              <tr><td>Staff</td><td id="staffCostResult"></td><td id="staffPercent"></td></tr>
              <tr><td>Maintenance & Repair</td><td id="maintenanceCost"></td><td id="maintenancePercent"></td></tr>
              <tr><td>Chemicals</td><td id="chemicalCost"></td><td id="chemicalPercent"></td></tr>
            </tbody>
          </table>
        </div>

        <div class="info-callout">
          <h4>📌 Benchmark Standards</h4>
          <ul>
            <li>Energy consumption benchmark: <strong>0.88 kWh/m³</strong> of treated wastewater.</li>
            <li>COD removal energy efficiency: <strong>2.22 kWh/kg COD</strong>.</li>
            <li>Typical breakdown: Electricity (~42%), Staff (~46%), Maintenance (~11%), Chemicals (~1%).</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── TAB 2: WATER TREATMENT ── -->
    <div id="water" class="tab-content">
      <div class="calc-card">
        <h2><i class="fas fa-tint" style="color:var(--accent)"></i> Water Treatment Plant Cost Model</h2>
        <p class="sub">Calculate capital expenditures and 20-year lifecycle operational costs per parameter.</p>

        <div class="form-grid">
          <div class="form-group"><label class="form-label">Plant Capacity (MLD)</label><input type="number" id="capacity" class="form-control" value="10"></div>
          <div class="form-group"><label class="form-label">Capital Cost (₹ Crores)</label><input type="number" id="capitalCost" class="form-control" value="25"></div>
          <div class="form-group"><label class="form-label">pH Correction (₹/m³)</label><input type="number" id="ph" class="form-control" value="0.50" step="0.01"></div>
          <div class="form-group"><label class="form-label">TDS Removal (₹/m³)</label><input type="number" id="tds" class="form-control" value="1.20" step="0.01"></div>
          <div class="form-group"><label class="form-label">BOD Reduction (₹/m³)</label><input type="number" id="bodWater" class="form-control" value="1.50" step="0.01"></div>
          <div class="form-group"><label class="form-label">COD Reduction (₹/m³)</label><input type="number" id="codWater" class="form-control" value="1.80" step="0.01"></div>
          <div class="form-group"><label class="form-label">Turbidity Removal (₹/m³)</label><input type="number" id="turbidity" class="form-control" value="0.75" step="0.01"></div>
          <div class="form-group"><label class="form-label">Operating Years</label><input type="number" id="operatingYears" class="form-control" value="20" min="1"></div>
        </div>

        <button class="btn btn-primary btn-lg" onclick="calculateWaterCost()">⚡ Calculate Lifecycle Cost</button>

        <div id="waterResults" class="results-panel">
          <h3>📊 Lifecycle Cost Results</h3>
          <div class="stat-cards-grid">
            <div class="stat-card"><div class="stat-card-label">Total Project Cost</div><div class="stat-card-val" id="totalProjectCost">—</div></div>
            <div class="stat-card"><div class="stat-card-label">Cost per m³</div><div class="stat-card-val" id="costPerCubicMeterWater">—</div></div>
            <div class="stat-card"><div class="stat-card-label">Annual Volume</div><div class="stat-card-val" id="annualTreatmentVolume">—</div></div>
          </div>

          <div class="chart-box"><canvas id="waterCostChart"></canvas></div>

          <table>
            <thead><tr><th>Cost Component</th><th>Total Cost</th><th>Percentage</th></tr></thead>
            <tbody>
              <tr><td>Capital Cost</td><td id="capitalCostResult"></td><td id="capitalPercent"></td></tr>
              <tr><td>pH Correction</td><td id="phCostResult"></td><td id="phPercent"></td></tr>
              <tr><td>TDS Removal</td><td id="tdsCostResult"></td><td id="tdsPercent"></td></tr>
              <tr><td>BOD Reduction</td><td id="bodCostResult"></td><td id="bodPercent"></td></tr>
              <tr><td>COD Reduction</td><td id="codCostResult"></td><td id="codPercent"></td></tr>
              <tr><td>Turbidity Removal</td><td id="turbidityCostResult"></td><td id="turbidityPercent"></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── TAB 3: COMPARE ── -->
    <div id="compare" class="tab-content">
      <div class="calc-card">
        <h2><i class="fas fa-balance-scale" style="color:var(--accent)"></i> Treatment Cost Comparison</h2>
        <p class="sub">Side-by-side comparison between Wastewater and Raw Water treatment cost models.</p>

        <div id="comparisonResults" class="results-panel" style="display:block;">
          <p style="color:var(--muted);text-align:center" id="compareMsg">Please calculate both Wastewater and Water treatment options first to generate comparison metrics.</p>
          <div id="compareDetails" style="display:none;">
            <div class="chart-box"><canvas id="comparisonChart"></canvas></div>
            <table>
              <thead><tr><th>Metric</th><th>Wastewater Treatment</th><th>Water Treatment</th></tr></thead>
              <tbody>
                <tr><td>Total Cost</td><td id="compareTotalWastewater"></td><td id="compareTotalWater"></td></tr>
                <tr><td>Cost per m³</td><td id="comparePerM3Wastewater"></td><td id="comparePerM3Water"></td></tr>
                <tr><td>Annual Volume</td><td id="compareVolumeWastewater"></td><td id="compareVolumeWater"></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Water Treatment Financial Analysis Module</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  let wastewaterChart = null, waterChart = null, comparisonChart = null;

  function openTab(tabId, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(tabId).classList.add('active');
    if (tabId === 'compare') updateComparison();
  }

  function calculateWastewaterCosts() {
    const population = parseFloat(document.getElementById('population').value);
    const dailyFlow = parseFloat(document.getElementById('flowRate').value);
    const energyCost = parseFloat(document.getElementById('energyCost').value);
    const staffCostPerPerson = parseFloat(document.getElementById('staffCost').value);

    const annualVolume = dailyFlow * 365;
    const totalEnergy = annualVolume * 0.88;
    const electricityCostAnnual = totalEnergy * energyCost;
    const staffCount = Math.max(5, Math.ceil(population / 20000));
    const staffCostAnnual = staffCount * staffCostPerPerson;
    const totalCostAnnual = electricityCostAnnual / 0.42;

    const maintenanceCostAnnual = totalCostAnnual * 0.11;
    const chemicalCostAnnual = totalCostAnnual * 0.01;
    const costPerCubicMeter = totalCostAnnual / annualVolume;

    document.getElementById('annualVolume').textContent = (annualVolume/1000000).toFixed(2) + ' M m³';
    document.getElementById('totalCost').textContent = '₹' + (totalCostAnnual / 10000000).toFixed(2) + ' Cr';
    document.getElementById('costPerCubicMeter').textContent = '₹' + costPerCubicMeter.toFixed(2);

    document.getElementById('electricityCost').textContent = '₹' + (electricityCostAnnual / 10000000).toFixed(2) + ' Cr';
    document.getElementById('electricityPercent').textContent = '42%';
    document.getElementById('staffCostResult').textContent = '₹' + (staffCostAnnual / 10000000).toFixed(2) + ' Cr';
    document.getElementById('staffPercent').textContent = '46%';
    document.getElementById('maintenanceCost').textContent = '₹' + (maintenanceCostAnnual / 10000000).toFixed(2) + ' Cr';
    document.getElementById('maintenancePercent').textContent = '11%';
    document.getElementById('chemicalCost').textContent = '₹' + (chemicalCostAnnual / 10000000).toFixed(2) + ' Cr';
    document.getElementById('chemicalPercent').textContent = '1%';

    document.getElementById('wastewaterResults').style.display = 'block';

    renderPieChart('wastewaterCostChart', ['Electricity', 'Staff', 'Maintenance', 'Chemicals'], [electricityCostAnnual, staffCostAnnual, maintenanceCostAnnual, chemicalCostAnnual], wastewaterChart, c => wastewaterChart = c);

    localStorage.setItem('wastewaterResults', JSON.stringify({ totalCost: totalCostAnnual, costPerM3: costPerCubicMeter, annualVolume }));
  }

  function calculateWaterCost() {
    const capacity = parseFloat(document.getElementById('capacity').value);
    const capitalCost = parseFloat(document.getElementById('capitalCost').value) * 10000000;
    const ph = parseFloat(document.getElementById('ph').value);
    const tds = parseFloat(document.getElementById('tds').value);
    const bod = parseFloat(document.getElementById('bodWater').value);
    const cod = parseFloat(document.getElementById('codWater').value);
    const turbidity = parseFloat(document.getElementById('turbidity').value);
    const years = parseFloat(document.getElementById('operatingYears').value);

    const annualVolume = capacity * 1000 * 365;
    const totalVolume = annualVolume * years;

    const phC = totalVolume * ph, tdsC = totalVolume * tds, bodC = totalVolume * bod, codC = totalVolume * cod, turbC = totalVolume * turbidity;
    const totalProjectCost = capitalCost + phC + tdsC + bodC + codC + turbC;
    const costPerM3 = totalProjectCost / totalVolume;

    document.getElementById('totalProjectCost').textContent = '₹' + (totalProjectCost / 10000000).toFixed(2) + ' Cr';
    document.getElementById('costPerCubicMeterWater').textContent = '₹' + costPerM3.toFixed(2);
    document.getElementById('annualTreatmentVolume').textContent = (annualVolume / 1000000).toFixed(1) + ' M m³';

    document.getElementById('capitalCostResult').textContent = '₹' + (capitalCost / 10000000).toFixed(2) + ' Cr';
    document.getElementById('capitalPercent').textContent = ((capitalCost/totalProjectCost)*100).toFixed(1) + '%';
    document.getElementById('phCostResult').textContent = '₹' + (phC / 10000000).toFixed(2) + ' Cr';
    document.getElementById('phPercent').textContent = ((phC/totalProjectCost)*100).toFixed(1) + '%';
    document.getElementById('tdsCostResult').textContent = '₹' + (tdsC / 10000000).toFixed(2) + ' Cr';
    document.getElementById('tdsPercent').textContent = ((tdsC/totalProjectCost)*100).toFixed(1) + '%';
    document.getElementById('bodCostResult').textContent = '₹' + (bodC / 10000000).toFixed(2) + ' Cr';
    document.getElementById('bodPercent').textContent = ((bodC/totalProjectCost)*100).toFixed(1) + '%';
    document.getElementById('codCostResult').textContent = '₹' + (codC / 10000000).toFixed(2) + ' Cr';
    document.getElementById('codPercent').textContent = ((codC/totalProjectCost)*100).toFixed(1) + '%';
    document.getElementById('turbidityCostResult').textContent = '₹' + (turbC / 10000000).toFixed(2) + ' Cr';
    document.getElementById('turbidityPercent').textContent = ((turbC/totalProjectCost)*100).toFixed(1) + '%';

    document.getElementById('waterResults').style.display = 'block';

    renderPieChart('waterCostChart', ['Capital', 'pH', 'TDS', 'BOD', 'COD', 'Turbidity'], [capitalCost, phC, tdsC, bodC, codC, turbC], waterChart, c => waterChart = c);

    localStorage.setItem('waterResults', JSON.stringify({ totalCost: totalProjectCost, costPerM3, annualVolume }));
  }

  function renderPieChart(id, labels, data, chartRef, setChart) {
    if (chartRef) chartRef.destroy();
    const ctx = document.getElementById(id).getContext('2d');
    const newChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{ data, backgroundColor: ['#00b4d8','#06d6a0','#9b72ff','#ff8c3c','#ffd166','#ef476f'], borderWidth: 2, borderColor: '#0a192f' }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8892b0' } } } }
    });
    setChart(newChart);
  }

  function updateComparison() {
    const ww = JSON.parse(localStorage.getItem('wastewaterResults'));
    const w = JSON.parse(localStorage.getItem('waterResults'));
    if (!ww || !w) return;

    document.getElementById('compareMsg').style.display = 'none';
    document.getElementById('compareDetails').style.display = 'block';

    document.getElementById('compareTotalWastewater').textContent = '₹' + (ww.totalCost / 10000000).toFixed(2) + ' Cr';
    document.getElementById('compareTotalWater').textContent = '₹' + (w.totalCost / 10000000).toFixed(2) + ' Cr';
    document.getElementById('comparePerM3Wastewater').textContent = '₹' + ww.costPerM3.toFixed(2);
    document.getElementById('comparePerM3Water').textContent = '₹' + w.costPerM3.toFixed(2);
    document.getElementById('compareVolumeWastewater').textContent = (ww.annualVolume/1000000).toFixed(1) + ' M m³';
    document.getElementById('compareVolumeWater').textContent = (w.annualVolume/1000000).toFixed(1) + ' M m³';

    if (comparisonChart) comparisonChart.destroy();
    const ctx = document.getElementById('comparisonChart').getContext('2d');
    comparisonChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['Cost per m³ (₹)'],
        datasets: [
          { label: 'Wastewater', data: [ww.costPerM3], backgroundColor: '#00b4d8' },
          { label: 'Water', data: [w.costPerM3], backgroundColor: '#06d6a0' }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8892b0' } } }, scales: { y: { ticks: { color: '#8892b0' } }, x: { ticks: { color: '#8892b0' } } } }
    });
  }
</script>
</body>
</html>