<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CCME Water Quality Index (CCME-WQI) — AquaGuard</title>
  <meta name="description" content="Calculate Canadian Council of Ministers of the Environment (CCME) Water Quality Index based on Scope, Frequency, and Amplitude.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--green), var(--accent)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem; }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: rgba(6,214,160,0.12); color: var(--green); font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi" style="color:var(--accent)">CCME-WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-green">🍁 Canadian Model</span>
        <h1>CCME Water Quality Index (CCME-WQI)</h1>
      </div>

      <table>
        <thead>
          <tr><th>Factor</th><th>Percentage Value (0 - 100)</th></tr>
        </thead>
        <tbody>
          <tr><td>Scope (F1 — % parameters exceeding limits)</td><td><input class="form-control" type="number" id="f1" placeholder="0 - 100" min="0" max="100"></td></tr>
          <tr><td>Frequency (F2 — % individual tests failing)</td><td><input class="form-control" type="number" id="f2" placeholder="0 - 100" min="0" max="100"></td></tr>
          <tr><td>Amplitude (F3 — magnitude of exceedance)</td><td><input class="form-control" type="number" id="f3" placeholder="0 - 100" min="0" max="100"></td></tr>
        </tbody>
      </table>

      <div style="display:flex;gap:1rem;justify-content:center">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="calculateCCMEWQI()">⚡ Calculate CCME-WQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — CCME Water Quality Index System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function resetForm() {
    ['f1','f2','f3'].forEach(id => document.getElementById(id).value = '');
    const res = document.getElementById("result"); res.style.display = 'none'; res.innerHTML = '';
  }

  function calculateCCMEWQI() {
    const f1 = parseFloat(document.getElementById("f1").value) || 0;
    const f2 = parseFloat(document.getElementById("f2").value) || 0;
    const f3 = parseFloat(document.getElementById("f3").value) || 0;

    if (f1 < 0 || f1 > 100 || f2 < 0 || f2 > 100 || f3 < 0 || f3 > 100) {
      alert("Please enter values between 0 and 100."); return;
    }

    const ccmeWQI = 100 - Math.sqrt((f1**2 + f2**2 + f3**2) / 1.732);

    let q = "Good", c = "var(--green)";
    if (ccmeWQI >= 95) { q = "Excellent"; c = "var(--green)"; }
    else if (ccmeWQI >= 80) { q = "Good"; c = "var(--accent)"; }
    else if (ccmeWQI >= 65) { q = "Fair"; c = "#ffd166"; }
    else if (ccmeWQI >= 45) { q = "Marginal"; c = "var(--warn)"; }
    else { q = "Poor"; c = "var(--danger)"; }

    const res = document.getElementById("result");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">CCME Water Quality Score</div>
      <div class="result-score" style="color:${c}">${ccmeWQI.toFixed(2)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Water Quality</div>
    `;
  }
</script>
</body>
</html>