<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Groundwater Quality Index (GWQI) — AquaGuard</title>
  <meta name="description" content="Calculate Groundwater Quality Index (GWQI) using weighted parameter analysis.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #00b4d8, #06d6a0); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem; }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: rgba(0,180,216,0.12); color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a><a href="/w2gwqi" style="color:var(--accent)">GWQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-cyan">🏞️ Groundwater Model</span>
        <h1>Groundwater Quality Index (GWQI)</h1>
      </div>

      <table>
        <thead>
          <tr><th>Parameter</th><th>Value</th></tr>
        </thead>
        <tbody>
          <tr><td>Quality Rating for Parameter 1 (Q1)</td><td><input class="form-control" type="number" id="q1" placeholder="0 - 100" min="0" max="100"></td></tr>
          <tr><td>Weight for Parameter 1 (W1)</td><td><input class="form-control" type="number" id="w1" placeholder="e.g. 0.3" min="0" step="0.01"></td></tr>
          <tr><td>Quality Rating for Parameter 2 (Q2)</td><td><input class="form-control" type="number" id="q2" placeholder="0 - 100" min="0" max="100"></td></tr>
          <tr><td>Weight for Parameter 2 (W2)</td><td><input class="form-control" type="number" id="w2" placeholder="e.g. 0.4" min="0" step="0.01"></td></tr>
          <tr><td>Quality Rating for Parameter 3 (Q3)</td><td><input class="form-control" type="number" id="q3" placeholder="0 - 100" min="0" max="100"></td></tr>
          <tr><td>Weight for Parameter 3 (W3)</td><td><input class="form-control" type="number" id="w3" placeholder="e.g. 0.3" min="0" step="0.01"></td></tr>
        </tbody>
      </table>

      <div style="display:flex;gap:1rem;justify-content:center">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="calculateGWQI()">⚡ Calculate GWQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Groundwater WQI System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function resetForm() {
    ['q1','w1','q2','w2','q3','w3'].forEach(id => document.getElementById(id).value = '');
    const res = document.getElementById("result"); res.style.display = 'none'; res.innerHTML = '';
  }

  function calculateGWQI() {
    const q1 = parseFloat(document.getElementById("q1").value) || 0;
    const w1 = parseFloat(document.getElementById("w1").value) || 0;
    const q2 = parseFloat(document.getElementById("q2").value) || 0;
    const w2 = parseFloat(document.getElementById("w2").value) || 0;
    const q3 = parseFloat(document.getElementById("q3").value) || 0;
    const w3 = parseFloat(document.getElementById("w3").value) || 0;

    const totalWeight = w1 + w2 + w3;
    if (totalWeight === 0) { alert("Total weight cannot be zero."); return; }

    const gwqi = ((q1 * w1) + (q2 * w2) + (q3 * w3)) / totalWeight;

    let q = "Good", c = "var(--green)";
    if (gwqi >= 90) { q = "Excellent"; c = "var(--green)"; }
    else if (gwqi >= 70) { q = "Good"; c = "var(--accent)"; }
    else if (gwqi >= 50) { q = "Fair"; c = "#ffd166"; }
    else if (gwqi >= 30) { q = "Poor"; c = "var(--warn)"; }
    else { q = "Very Poor"; c = "var(--danger)"; }

    const res = document.getElementById("result");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">GWQI Calculated Result</div>
      <div class="result-score" style="color:${c}">${gwqi.toFixed(2)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Groundwater Quality</div>
    `;
  }
</script>
</body>
</html>