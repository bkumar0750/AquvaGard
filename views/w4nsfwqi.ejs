<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NSF Water Quality Index (NSF-WQI) — AquaGuard</title>
  <meta name="description" content="Calculate water quality using the National Sanitation Foundation (NSF-WQI) 9-parameter methodology.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #9b72ff, var(--accent)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem; }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: rgba(155,114,255,0.1); color: #9b72ff; font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi" style="color:var(--accent)">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-cyan" style="background:rgba(155,114,255,0.12);color:#9b72ff;border-color:rgba(155,114,255,0.3)">🏛️ Standard Method</span>
        <h1>NSF Water Quality Index (NSF-WQI)</h1>
      </div>

      <table>
        <thead>
          <tr><th>Parameter</th><th>Value</th></tr>
        </thead>
        <tbody>
          <tr><td>Dissolved Oxygen (DO) — mg/L</td><td><input class="form-control" type="number" id="do" placeholder="e.g. 8.5" min="0" step="0.1"></td></tr>
          <tr><td>Fecal Coliform — CFU/100mL</td><td><input class="form-control" type="number" id="fc" placeholder="e.g. 20" min="0"></td></tr>
          <tr><td>pH Level (0-14)</td><td><input class="form-control" type="number" id="ph" placeholder="e.g. 7.4" min="0" max="14" step="0.1"></td></tr>
          <tr><td>BOD — mg/L</td><td><input class="form-control" type="number" id="bod" placeholder="e.g. 2.1" min="0" step="0.1"></td></tr>
          <tr><td>Nitrates — mg/L</td><td><input class="form-control" type="number" id="nitrates" placeholder="e.g. 5.0" min="0" step="0.1"></td></tr>
          <tr><td>Total Phosphates — mg/L</td><td><input class="form-control" type="number" id="phosphates" placeholder="e.g. 0.3" min="0" step="0.1"></td></tr>
          <tr><td>Turbidity — NTU</td><td><input class="form-control" type="number" id="turbidity" placeholder="e.g. 4.2" min="0" step="0.1"></td></tr>
          <tr><td>Total Solids — mg/L</td><td><input class="form-control" type="number" id="solids" placeholder="e.g. 150" min="0" step="0.1"></td></tr>
          <tr><td>Water Temperature — °C</td><td><input class="form-control" type="number" id="temp" placeholder="e.g. 22.0" min="-20" max="50" step="0.1"></td></tr>
        </tbody>
      </table>

      <div style="display:flex;gap:1rem;justify-content:center">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="calculateWQI()">⚡ Calculate NSF-WQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — NSF Water Quality Index System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function resetForm() {
    ['do','fc','ph','bod','nitrates','phosphates','turbidity','solids','temp'].forEach(id => document.getElementById(id).value = '');
    const res = document.getElementById("result"); res.style.display = 'none'; res.innerHTML = '';
  }

  function calculateSubIndex(val, min, max) {
    if (val <= min) return 100;
    if (val >= max) return 0;
    return 100 - ((val - min) / (max - min)) * 100;
  }

  function calculateWQI() {
    const doV = parseFloat(document.getElementById("do").value) || 0;
    const fcV = parseFloat(document.getElementById("fc").value) || 0;
    const phV = parseFloat(document.getElementById("ph").value) || 7;
    const bodV = parseFloat(document.getElementById("bod").value) || 0;
    const nitV = parseFloat(document.getElementById("nitrates").value) || 0;
    const phoV = parseFloat(document.getElementById("phosphates").value) || 0;
    const turV = parseFloat(document.getElementById("turbidity").value) || 0;
    const solV = parseFloat(document.getElementById("solids").value) || 0;
    const tmpV = parseFloat(document.getElementById("temp").value) || 20;

    const subs = [
      calculateSubIndex(doV, 14, 0),
      calculateSubIndex(fcV, 0, 1000),
      calculateSubIndex(Math.abs(phV - 7.5), 0, 6.5),
      calculateSubIndex(bodV, 0, 30),
      calculateSubIndex(nitV, 0, 100),
      calculateSubIndex(phoV, 0, 10),
      calculateSubIndex(turV, 0, 100),
      calculateSubIndex(solV, 0, 500),
      calculateSubIndex(Math.abs(tmpV - 20), 0, 30)
    ];

    const weights = [0.17, 0.16, 0.11, 0.11, 0.10, 0.10, 0.08, 0.07, 0.10];
    let wqi = 0;
    for (let i = 0; i < weights.length; i++) wqi += subs[i] * weights[i];

    let q = "Good", c = "var(--green)";
    if (wqi >= 90) { q = "Excellent"; c = "var(--green)"; }
    else if (wqi >= 70) { q = "Good"; c = "var(--accent)"; }
    else if (wqi >= 50) { q = "Medium"; c = "#ffd166"; }
    else if (wqi >= 25) { q = "Bad"; c = "var(--warn)"; }
    else { q = "Very Bad"; c = "var(--danger)"; }

    const res = document.getElementById("result");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">NSF Water Quality Score</div>
      <div class="result-score" style="color:${c}">${wqi.toFixed(2)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Water Quality</div>
    `;
  }
</script>
</body>
</html>