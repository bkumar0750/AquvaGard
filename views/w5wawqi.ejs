<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weighted Arithmetic WQI (WA-WQI) — AquaGuard</title>
  <meta name="description" content="Calculate Weighted Arithmetic Water Quality Index (WA-WQI) with custom parameter weights and standard values.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #4b6cb7, var(--accent)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem; }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: rgba(75,108,183,0.15); color: #789fff; font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi" style="color:var(--accent)">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-cyan" style="background:rgba(75,108,183,0.15);color:#789fff;border-color:rgba(75,108,183,0.3)">📐 Weighted Arithmetic</span>
        <h1>Weighted Arithmetic WQI (WA-WQI)</h1>
      </div>

      <table>
        <thead>
          <tr><th>Parameter Variable</th><th>Input Value</th></tr>
        </thead>
        <tbody>
          <tr><td>Observed Value (Vn)</td><td><input class="form-control" type="number" id="vn" placeholder="e.g. 7.5" step="any"></td></tr>
          <tr><td>Standard Permissible Value (Sn)</td><td><input class="form-control" type="number" id="sn" placeholder="e.g. 8.5" step="any"></td></tr>
          <tr><td>Ideal Value (Vi)</td><td><input class="form-control" type="number" id="vi" placeholder="e.g. 7.0 (0 for DO)" step="any"></td></tr>
          <tr><td>Unit Weight (Wi)</td><td><input class="form-control" type="number" id="wi" placeholder="e.g. 0.25" step="any"></td></tr>
        </tbody>
      </table>

      <div style="display:flex;gap:1rem;justify-content:center">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="calculateWAWQI()">⚡ Calculate WA-WQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Weighted Arithmetic WQI System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function resetForm() {
    ['vn','sn','vi','wi'].forEach(id => document.getElementById(id).value = '');
    const res = document.getElementById("result"); res.style.display = 'none'; res.innerHTML = '';
  }

  function calculateWAWQI() {
    const vn = parseFloat(document.getElementById("vn").value);
    const sn = parseFloat(document.getElementById("sn").value);
    const vi = parseFloat(document.getElementById("vi").value);
    const wi = parseFloat(document.getElementById("wi").value);

    if (isNaN(vn) || isNaN(sn) || isNaN(vi) || isNaN(wi) || sn === vi || wi === 0) {
      alert("Please provide valid numerical inputs (Standard value cannot equal Ideal value, Weight cannot be zero).");
      return;
    }

    const qi = ((vn - vi) / (sn - vi)) * 100;
    const wawqi = Math.abs(qi);

    let q = "Excellent", c = "var(--green)";
    if (wawqi <= 25) { q = "Excellent"; c = "var(--green)"; }
    else if (wawqi <= 50) { q = "Good"; c = "var(--accent)"; }
    else if (wawqi <= 75) { q = "Poor"; c = "#ffd166"; }
    else if (wawqi <= 100) { q = "Very Poor"; c = "var(--warn)"; }
    else { q = "Unfit for Drinking"; c = "var(--danger)"; }

    const res = document.getElementById("result");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">WA-WQI Calculated Rating</div>
      <div class="result-score" style="color:${c}">${wawqi.toFixed(2)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Water Quality</div>
    `;
  }
</script>
</body>
</html>