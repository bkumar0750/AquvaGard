<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simple Water Quality Index (SWQI) — AquaGuard</title>
  <meta name="description" content="Calculate Simple Water Quality Index (SWQI) using key water parameters.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--green)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem; }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }
    th { background: rgba(0,180,216,0.1); color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 0.73rem; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .range-box {
      background: rgba(0,180,216,0.08); border: 1px solid rgba(0,180,216,0.2);
      border-radius: var(--r-sm); padding: 0.25rem 0.6rem; font-size: 0.78rem; color: var(--accent); display: inline-block;
    }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi" style="color:var(--accent)">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-cyan">💧 Index Calculator</span>
        <h1>Simple Water Quality Index (SWQI)</h1>
      </div>

      <table>
        <thead>
          <tr><th>Parameter</th><th>Data Entry</th><th>Acceptable Range</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Temperature (°C)</td>
            <td><input class="form-control" type="number" id="temperature" placeholder="0 - 40" min="0" max="40" step="0.1"></td>
            <td><span class="range-box">0°C — 40°C</span></td>
          </tr>
          <tr>
            <td>BOD (mg/L)</td>
            <td><input class="form-control" type="number" id="bod" placeholder="0 - 12" min="0" max="12" step="0.1"></td>
            <td><span class="range-box">0 — 12 mg/L</span></td>
          </tr>
          <tr>
            <td>TSS (mg/L)</td>
            <td><input class="form-control" type="number" id="tss" placeholder="0 - 250" min="0" max="250" step="1"></td>
            <td><span class="range-box">0 — 250 mg/L</span></td>
          </tr>
          <tr>
            <td>DO (mg/L)</td>
            <td><input class="form-control" type="number" id="do" placeholder="0 - 10" min="0" max="10" step="0.1"></td>
            <td><span class="range-box">0 — 10 mg/L</span></td>
          </tr>
          <tr>
            <td>Conductivity (μS/cm)</td>
            <td><input class="form-control" type="number" id="conductivity" placeholder="1 - 4000" min="1" max="4000" step="1"></td>
            <td><span class="range-box">1 — 4000 μS/cm</span></td>
          </tr>
        </tbody>
      </table>

      <div style="display:flex;gap:1rem;justify-content:center">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="submitForm()">⚡ Calculate Index</button>
      </div>

      <div class="result-box" id="waterQualityIndex"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Water Quality Index System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function resetForm() {
    ['temperature', 'bod', 'tss', 'do', 'conductivity'].forEach(id => document.getElementById(id).value = '');
    const res = document.getElementById("waterQualityIndex");
    res.style.display = 'none'; res.innerHTML = '';
  }

  function submitForm() {
    const temp = parseFloat(document.getElementById("temperature").value) || 0;
    const bod = parseFloat(document.getElementById("bod").value) || 0;
    const tss = parseFloat(document.getElementById("tss").value) || 0;
    const doVal = parseFloat(document.getElementById("do").value) || 0;
    const cond = parseFloat(document.getElementById("conductivity").value) || 0;

    const tNorm = 1 - Math.min(Math.abs(temp - 20) / 20, 1);
    const bNorm = 1 - (bod / 12);
    const sNorm = 1 - (tss / 250);
    const dNorm = doVal / 10;
    const cNorm = 1 - ((cond - 1) / 3999);

    const wqi = ((tNorm * 0.15) + (bNorm * 0.25) + (sNorm * 0.2) + (dNorm * 0.25) + (cNorm * 0.15)) * 100;

    let q = "Excellent", c = "var(--green)";
    if (wqi < 20) { q = "Very Poor"; c = "var(--danger)"; }
    else if (wqi < 40) { q = "Poor"; c = "var(--warn)"; }
    else if (wqi < 60) { q = "Fair"; c = "#ffd166"; }
    else if (wqi < 80) { q = "Good"; c = "var(--accent)"; }

    const res = document.getElementById("waterQualityIndex");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">Calculated SWQI</div>
      <div class="result-score" style="color:${c}">${wqi.toFixed(2)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Water Quality</div>
    `;
  }
</script>
</body>
</html>