<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DELPHI Water Quality Index (DELPHI-WQI) — AquaGuard</title>
  <meta name="description" content="Calculate Water Quality Index using the DELPHI consensus panel method.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 900px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #9b72ff, var(--accent)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    .param-row {
      display: grid; grid-template-columns: 100px 1fr 1fr 1fr 90px; gap: 0.75rem; align-items: center;
      margin-bottom: 0.75rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border);
      border-radius: var(--r); padding: 0.75rem;
    }
    @media(max-width:600px){ .param-row { grid-template-columns: 1fr; } }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a><a href="/w7delphiwqi" style="color:var(--accent)">DELPHI WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-cyan" style="background:rgba(155,114,255,0.15);color:#9b72ff;border-color:rgba(155,114,255,0.3)">🔮 Consensus Panel Model</span>
        <h1>DELPHI Water Quality Index (DELPHI-WQI)</h1>
      </div>

      <div id="parameters-container">
        <div class="param-row">
          <span style="font-weight:700;color:var(--accent);font-size:0.85rem">Param 1:</span>
          <input type="text" placeholder="Parameter Name" class="form-control param-name" value="Dissolved Oxygen">
          <input type="number" placeholder="Rating (0-100)" min="0" max="100" class="form-control param-rating" value="85">
          <input type="number" placeholder="Weight (0-1)" step="0.01" min="0" max="1" class="form-control param-weight" value="0.2">
          <button class="btn btn-ghost remove-param" style="color:var(--danger)">Remove</button>
        </div>
      </div>

      <div style="display:flex;gap:1rem;margin-top:1.5rem;justify-content:center">
        <button class="btn btn-ghost" id="addParamBtn">➕ Add Parameter</button>
        <button class="btn btn-primary" id="calculateBtn">⚡ Calculate DELPHI-WQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — DELPHI WQI System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('parameters-container');
    const addBtn = document.getElementById('addParamBtn');
    const calculateBtn = document.getElementById('calculateBtn');
    const resultDiv = document.getElementById('result');

    addBtn.addEventListener('click', function() {
      const count = container.children.length + 1;
      const row = document.createElement('div');
      row.className = 'param-row';
      row.innerHTML = `
        <span style="font-weight:700;color:var(--accent);font-size:0.85rem">Param ${count}:</span>
        <input type="text" placeholder="Parameter Name" class="form-control param-name">
        <input type="number" placeholder="Rating (0-100)" min="0" max="100" class="form-control param-rating">
        <input type="number" placeholder="Weight (0-1)" step="0.01" min="0" max="1" class="form-control param-weight">
        <button class="btn btn-ghost remove-param" style="color:var(--danger)">Remove</button>
      `;
      container.appendChild(row);
      row.querySelector('.remove-param').addEventListener('click', () => row.remove());
    });

    calculateBtn.addEventListener('click', function() {
      const rows = container.querySelectorAll('.param-row');
      let totalWeight = 0, sum = 0;
      rows.forEach(r => {
        const rating = parseFloat(r.querySelector('.param-rating').value) || 0;
        const weight = parseFloat(r.querySelector('.param-weight').value) || 0;
        if (weight > 0) { sum += rating * weight; totalWeight += weight; }
      });

      if (totalWeight === 0) { alert("Please enter valid positive weights."); return; }
      const wqi = sum / totalWeight;

      let q = "Good", c = "var(--green)";
      if (wqi >= 90) { q = "Excellent"; c = "var(--green)"; }
      else if (wqi >= 70) { q = "Good"; c = "var(--accent)"; }
      else if (wqi >= 50) { q = "Fair"; c = "#ffd166"; }
      else { q = "Poor"; c = "var(--danger)"; }

      resultDiv.style.display = 'block';
      resultDiv.innerHTML = `
        <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">DELPHI WQI Score</div>
        <div class="result-score" style="color:${c}">${wqi.toFixed(1)}</div>
        <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q} Water Quality</div>
      `;
    });
  });
</script>
</body>
</html>