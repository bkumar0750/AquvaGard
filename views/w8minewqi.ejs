<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mining Effluent WQI — AquaGuard</title>
  <meta name="description" content="Calculate Indian Mine Effluent Quality Index based on physical, undesirable, and toxic parameters.">
  <link rel="stylesheet" href="/styles/global.css">
  <style>
    .wqi-page { padding: calc(var(--nav-h) + 2.5rem) 1.5rem 5rem; min-height: 100vh; }
    .wqi-container { max-width: 1000px; margin: 0 auto; }
    .wqi-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg);
      padding: 2.25rem; box-shadow: var(--shadow); position: relative; overflow: hidden;
    }
    .wqi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #ff8c3c, var(--danger)); }
    .wqi-header { text-align: center; margin-bottom: 2rem; }
    .wqi-header h1 { font-size: 1.8rem; font-weight: 800; color: var(--white); margin-top: 0.5rem; }

    .tabs { display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
    .tab {
      padding: 0.75rem 1.25rem; cursor: pointer; font-weight: 600; color: var(--muted);
      border-bottom: 2px solid transparent; transition: var(--t); font-size: 0.9rem;
    }
    .tab.active { color: var(--accent); border-bottom-color: var(--accent); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .param-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .param-card { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: var(--r); padding: 1rem; }
    .param-card label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--white); margin-bottom: 0.5rem; }

    .result-box {
      display: none; text-align: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: var(--r); padding: 1.75rem; margin-top: 2rem;
    }
    .result-score { font-size: 3rem; font-weight: 800; margin: 0.5rem 0; font-family: 'Roboto Mono', monospace; }
    .result-badge { display: inline-block; padding: 0.4rem 1.25rem; border-radius: 50px; font-weight: 700; font-size: 0.95rem; }
  </style>
</head>
<body>
<nav class="navbar scrolled" id="navbar">
  <a href="/fwater" class="nav-brand"><div class="nav-logo">💧</div><span class="nav-name">Aqua<span>Guard</span></span></a>
  <ul class="nav-links" id="navLinks">
    <li class="nav-dd"><button>Data Entry</button><div class="dd-menu"><a href="/physical">🧪 Physical</a><a href="/chemical">⚗️ Chemical</a><a href="/biological">🦠 Biological</a><a href="/environmental">🌿 Environmental</a><a href="/air">💨 Air Quality</a></div></li>
    <li class="nav-dd"><a href="#">WQI</a><div class="dd-menu"><a href="/w6swqi">Simple WQI</a><a href="/w4nsfwqi">NSF-WQI</a><a href="/w5wawqi">WA-WQI</a><a href="/w1ccmewqi">CCME-WQI</a><a href="/w8minewqi" style="color:var(--accent)">Mine Effluent WQI</a></div></li>
    <li><a href="/treatment">Treatment</a></li><li><a href="/AQI">AQI</a></li><li><a href="/parameters">Parameters</a></li><li><a href="/information">Data Info</a></li>
  </ul>
  <button class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')"><span></span><span></span><span></span></button>
</nav>

<div class="wqi-page">
  <div class="wqi-container">
    <div class="wqi-card fu">
      <div class="wqi-header">
        <span class="badge badge-warn">⛏️ Industrial Mining Model</span>
        <h1>Indian Mine Effluent Quality Index</h1>
      </div>

      <div class="tabs">
        <div class="tab active" onclick="switchTab('physical')">1. Physical Parameters</div>
        <div class="tab" onclick="switchTab('undesirable')">2. Undesirable Parameters</div>
        <div class="tab" onclick="switchTab('toxic')">3. Toxic Parameters</div>
      </div>

      <div class="tab-content active" id="tab-physical">
        <div class="param-grid">
          <div class="param-card"><label>Suspended Solids (mg/L)</label><input class="form-control" type="number" id="ss" placeholder="0 - 100"></div>
          <div class="param-card"><label>pH Value</label><input class="form-control" type="number" id="ph" placeholder="6.5 - 8.5"></div>
          <div class="param-card"><label>Temperature (°C)</label><input class="form-control" type="number" id="temp" placeholder="e.g. 25"></div>
          <div class="param-card"><label>BOD (mg/L)</label><input class="form-control" type="number" id="bod" placeholder="e.g. 10"></div>
          <div class="param-card"><label>COD (mg/L)</label><input class="form-control" type="number" id="cod" placeholder="e.g. 50"></div>
        </div>
      </div>

      <div class="tab-content" id="tab-undesirable">
        <div class="param-grid">
          <div class="param-card"><label>Oil & Grease (mg/L)</label><input class="form-control" type="number" id="oil" placeholder="e.g. 2"></div>
          <div class="param-card"><label>Ammoniacal Nitrogen (mg/L)</label><input class="form-control" type="number" id="nh4" placeholder="e.g. 5"></div>
          <div class="param-card"><label>Fluoride (mg/L)</label><input class="form-control" type="number" id="fluoride" placeholder="e.g. 1.0"></div>
          <div class="param-card"><label>Iron (mg/L)</label><input class="form-control" type="number" id="iron" placeholder="e.g. 0.3"></div>
        </div>
      </div>

      <div class="tab-content" id="tab-toxic">
        <div class="param-grid">
          <div class="param-card"><label>Arsenic (mg/L)</label><input class="form-control" type="number" id="arsenic" placeholder="e.g. 0.01"></div>
          <div class="param-card"><label>Lead (mg/L)</label><input class="form-control" type="number" id="lead" placeholder="e.g. 0.01"></div>
          <div class="param-card"><label>Cadmium (mg/L)</label><input class="form-control" type="number" id="cadmium" placeholder="e.g. 0.003"></div>
          <div class="param-card"><label>Cyanide (mg/L)</label><input class="form-control" type="number" id="cyanide" placeholder="e.g. 0.05"></div>
        </div>
      </div>

      <div style="display:flex;gap:1rem;justify-content:center;margin-top:1.5rem">
        <button class="btn btn-ghost" onclick="resetForm()">Reset</button>
        <button class="btn btn-primary" onclick="calculateMineWQI()">⚡ Calculate Mine Effluent WQI</button>
      </div>

      <div class="result-box" id="result"></div>
    </div>
  </div>
</div>

<footer class="footer"><p>© 2025 <strong>AquaGuard</strong> — Mining Effluent WQI System</p></footer>

<script>
  window.addEventListener('scroll', () => document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 10));

  function switchTab(name) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    event.target.classList.add('active');
    document.getElementById('tab-' + name).classList.add('active');
  }

  function resetForm() {
    ['ss','ph','temp','bod','cod','oil','nh4','fluoride','iron','arsenic','lead','cadmium','cyanide'].forEach(id => {
      const el = document.getElementById(id); if (el) el.value = '';
    });
    const res = document.getElementById("result"); res.style.display = 'none'; res.innerHTML = '';
  }

  function calculateMineWQI() {
    const ph = parseFloat(document.getElementById("ph").value) || 7.0;
    const ss = parseFloat(document.getElementById("ss").value) || 20;
    const bod = parseFloat(document.getElementById("bod").value) || 5;

    let score = 100 - (Math.abs(7.0 - ph) * 10 + ss * 0.3 + bod * 2);
    score = Math.max(0, Math.min(100, score));

    let q = "Safe Discharge", c = "var(--green)";
    if (score >= 80) { q = "Permissible / Safe"; c = "var(--green)"; }
    else if (score >= 60) { q = "Moderate Treatment Needed"; c = "#ffd166"; }
    else if (score >= 40) { q = "High Contamination"; c = "var(--warn)"; }
    else { q = "Hazardous Effluent"; c = "var(--danger)"; }

    const res = document.getElementById("result");
    res.style.display = 'block';
    res.innerHTML = `
      <div style="font-size:0.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">Mining Effluent Quality Score</div>
      <div class="result-score" style="color:${c}">${score.toFixed(1)}</div>
      <div class="result-badge" style="background:${c}20;color:${c};border:1px solid ${c}">${q}</div>
    `;
  }
</script>
</body>
</html>